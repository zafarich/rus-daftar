# Eski loyihadagi qiymatlar
BOT_TOKEN=123456:ABC...
DOMAIN=daftar.example.uz

# Ixtiyoriy. Bot hamma uchun ochiq; OWNER_ID faqat eski (bitta foydalanuvchili) bazadagi
# natijalarni kimga o'tkazishni bildiradi. Telegram ID: botga /myid yuboring.
OWNER_ID=0

# Brauzer havolalarini imzolash kaliti (uzun tasodifiy satr): openssl rand -hex 24
# O'zgartirilsa, ilgari berilgan «Brauzerda ochish» havolalari ishlamay qoladi.
ACCESS_KEY=

TZ_NAME=Asia/Tashkent
QUIZ_TIMES=09:00,13:00,19:00
QUIZ_SIZE=5
PLAN_MORNING=08:30
PLAN_EVENING=21:30

# Ixtiyoriy: to'liq gaplarni AI tekshirsin (bo'sh qolsa oddiy tekshiruv)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Docker'siz (venv + systemd) ishlatsangiz: port faqat nginx'ga ochiq bo'lsin.
# 8000 band bo'lsa, boshqa port tanlang va nginx'da ham o'zgartiring.
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# Lokal sinovda (http) false qiling
COOKIE_SECURE=true
